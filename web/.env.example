# Copy to .env.local for local work. Real values go in the host's settings (Vercel), never in git.

# YouTube Data API v3 key. Only the ingest (npm run ingest) needs it.
YOUTUBE_API_KEY=

# Supabase project (Project Settings -> API Keys). Both are public by design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Set to 1 only on the real production site. Anything else asks search engines not to index.
NEXT_PUBLIC_ALLOW_INDEXING=
